# =============================================================================
#  UserNeed — образец конфигурации. Скопируйте в .env и заполните.
#  Пустые необязательные значения = значения по умолчанию.
# =============================================================================

# --- Обязательные ------------------------------------------------------------
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA   # @BotFather
API_ID=12345                                               # https://my.telegram.org
API_HASH=0123456789abcdef0123456789abcdef                  # https://my.telegram.org

# --- Доступ ------------------------------------------------------------------
ADMIN_IDS=111111111,222222222        # операторы: безлимит, мониторинг, /stats
BETA_MODE=1                          # 1 — закрытая бета (только whitelist), 0 — открыт всем
ALLOWED_USER_IDS=                    # whitelist через запятую (при BETA_MODE=1)
USAGE_LIMIT=3                        # сеансов на участника (генерация или пакетная проверка)

# --- Telethon-сессии (служебные аккаунты для проверок) -----------------------
SESSION_NAMES=acc1,acc2              # имена файлов сессий; логин: python qr_login.py acc1

# --- Чекер -------------------------------------------------------------------
CHECK_CONCURRENCY=4                  # параллельных проверок
CHECK_DELAY_MIN=1.5                  # пауза между запросами ОДНОЙ сессии, сек
CHECK_DELAY_MAX=3.0
FLOOD_COOLDOWN_EXTRA=3               # запас к FloodWait, сек
FLOOD_PARK_THRESHOLD=300
HTTP_PRECHECK_ENABLED=1              # отсев занятых через https://t.me/<name>

# --- Генерация ---------------------------------------------------------------
GLOBAL_GEN_CONCURRENCY=1             # одновременных прогонов на всю систему (не трогать)
GEN_MAX_SMART=10                     # потолок объёма для осмысленных / похожих (3..30)
GEN_MAX_RANDOM=20                    # потолок для случайных (5..50)
GEN_BUSY_RETRY_HINT=45               # «повторите через N сек» при занятости
USE_EXTERNAL_DICT=1                  # словари из assets/
SIMILAR_MAX_RESULTS=20
FILTER_MIN_SCORE=3                   # не показывать имена с оценкой ниже (1..10)

# --- Хранилище ---------------------------------------------------------------
STORAGE_ENABLED=1                    # история находок (found.db)
FOUND_HISTORY_DAYS=30
DATA_DIR=                            # где лежат *.db, *.session, logs/, backups/ (пусто = корень проекта)

# --- Watchlist (только операторы) -------------------------------------------
WATCH_HOT_INTERVAL=3600              # < 1 дня в списке: проверять раз в час
WATCH_WARM_INTERVAL=14400            # < 7 дней: раз в 4 часа
WATCH_COLD_INTERVAL=86400            # старше: раз в сутки
WATCH_BATCH_SIZE=30
WATCH_SLEEP_AFTER_DAYS=20            # taken без изменений N дней → в архив

# --- Бэкапы ------------------------------------------------------------------
BACKUP_INCLUDE_SECRETS=0             # 1 — класть .env и *.session в zip (ОПАСНО: архив не шифруется)

# --- Брендинг ----------------------------------------------------------------
BANNER_PATH=assets/banner.png        # картинка /start: путь или URL; пусто = без баннера
